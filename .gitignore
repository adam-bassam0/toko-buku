.env
.env.*
!.env.example

# ===== Upload pengguna =====
storage/uploads/bukti/*
!storage/uploads/bukti/.gitignore

# ===== Arsip / file sampah =====
*.zip

# ===== Dependency (jika nanti pakai Composer/npm) =====
vendor/
node_modules/
